# Copy this file to .env.local for local dev (Vite auto-loads it)
# Set the same values in Vercel/Netlify -> Environment Variables for deployment

# Your Flask backend URL (Render, etc.)
VITE_API_URL=http://localhost:5000
# After deploying to Render, update to:
# VITE_API_URL=https://semai-backend.onrender.com

# Supabase -- Project Settings -> API in your Supabase dashboard
# Only the PUBLIC anon key goes here -- never the service role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
