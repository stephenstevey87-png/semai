# Copy this file to .env.local for local dev (Vite auto-loads it)
# Set the same values in Netlify -> Site settings -> Environment variables for deployment

# Supabase -- Project Settings -> API in your Supabase dashboard
# Only the PUBLIC anon key goes here -- never the service role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NOTE: no backend URL needed anymore. All AI calls go through Supabase Edge
# Functions (chat, explain-slide, generate-course), and course reads/writes
# go directly to the Supabase database with Row Level Security enforcing
# that lecturers can only write their own courses. See supabase/functions/
# and supabase/schema.sql.
