# Copy this file to .env (or set these as real environment variables on Render/wherever you deploy)
# Never commit a filled-in .env file to git — this .env.example is a template only.

# Anthropic — powers chat, slide narration, and AI course generation
ANTHROPIC_API_KEY=your-anthropic-api-key

# Supabase — Project Settings -> API in your Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key: SECRET. Backend-only. Bypasses Row Level Security.
# Never send this to the frontend or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anon (public) key — same key the frontend uses, safe to reuse here.
SUPABASE_ANON_KEY=your-anon-key
